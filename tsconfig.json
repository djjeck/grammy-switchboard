{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    // The examples import the package by name, as a consumer does; typechecked against src/.
    "paths": {
      "grammy-switchboard": ["./src/index.ts"],
      "grammy-switchboard/sqlite": ["./src/sqlite.ts"]
    }
  },
  "include": ["src", "tests", "examples", "vitest.config.ts"]
}
